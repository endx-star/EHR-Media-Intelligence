# Local development configuration. Never put real secrets in this file.
APP_ENV=development
DEBUG=false

# Comma-separated exact frontend origins; no wildcard.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Upload and parser limits
MAX_UPLOAD_BYTES=10485760
MAX_RECORDS_PER_FILE=5000
MAX_FIELD_CHARS=20000

# Task 3 - configure one provider locally in .env (not committed)
LLM_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=
